# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Windows scripts keep CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary media, fonts, models & archives
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.mp3 binary
*.wav binary
*.ogg binary
*.flac binary
*.m4a binary
*.mp4 binary
*.webm binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.onnx binary
*.bin binary
*.zip binary
*.tgz binary
*.gz binary
*.exe binary
