{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Storia Studio",
  "version": "0.2.0",
  "identifier": "com.storiastudio.desktop",
  "build": {
    "frontendDist": "../splash"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Storia Studio — 2D & Retro NLE",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "backgroundColor": "#0b0c10"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "Mairon Mayorga",
    "category": "Video",
    "copyright": "Copyright (c) 2026 Mairon Mayorga. All rights reserved.",
    "shortDescription": "Local-first 2D & Retro Video Editor (NLE) with WebGL2 and MCP",
    "longDescription": "Storia Studio is a local-first 2D and retro non-linear video editor with 60 FPS WebGL2 preview, 23 full-pipeline animation styles, 1:1 FFmpeg NVENC/CPU export, multi-provider TTS, and live bidirectional MCP control.",
    "licenseFile": "../../../LICENSE.md",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/runtime": "runtime"
    },
    "windows": {
      "allowDowngrades": true,
      "nsis": {
        "installMode": "both",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "es-ES"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    },
    "linux": {
      "deb": {
        "depends": ["ffmpeg"]
      },
      "rpm": {
        "depends": ["ffmpeg"]
      },
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  }
}
